{
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.next": true,
    "**/src/generated": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.next/**": true,
    "**/src/generated/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.next": true,
    "**/src/generated": true,
    "**/package-lock.json": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "json.schemaDownload.enable": true
}
